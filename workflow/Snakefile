import os
import glob
from pathlib import Path

configfile: "config/config.yaml"

GENOMES = []
if os.path.exists(config["genomes_list"]):
    with open(config["genomes_list"]) as f:
        GENOMES = [line.strip() for line in f if line.strip() and (line.startswith("GCF_") or line.startswith("GCA_"))]

GBK_DIR = config["gbk_dir"]
GBKS = [Path(f).stem for f in glob.glob(os.path.join(GBK_DIR, "*.gbk"))]
TARGETS = config["targets"]

rule all:
    input:
        "results/summary_hits.tsv",
        expand("results/phylogeny/{genome}_{gbk}_{target}.treefile", genome=GENOMES, gbk=GBKS, target=TARGETS)

rule download_genome:
    output:
        fasta = temp("resources/genomes/{genome}.fna")
    benchmark:
        "execution_reports/benchmarks/download_genome/{genome}.txt"
    log:
        "execution_reports/logs/download_genome/{genome}.log"
    conda:
        "envs/datasets.yaml"
    retries: 3
    threads: 1
    resources:
        mem_mb=1000,
        runtime=30
    shell:
        """
        datasets download genome accession {wildcards.genome} --include genome --filename resources/genomes/{wildcards.genome}.zip > {log} 2>&1
        unzip -p resources/genomes/{wildcards.genome}.zip ncbi_dataset/data/{wildcards.genome}/*.fna > {output.fasta} 2>> {log}
        rm resources/genomes/{wildcards.genome}.zip
        """

rule makeblastdb:
    input:
        fasta = "resources/genomes/{genome}.fna"
    output:
        db_dir = directory("resources/blast_dbs/{genome}")
    benchmark:
        "execution_reports/benchmarks/makeblastdb/{genome}.txt"
    log:
        "execution_reports/logs/makeblastdb/{genome}.log"
    conda:
        "envs/blast.yaml"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=30
    shell:
        """
        mkdir -p {output.db_dir}
        makeblastdb -in {input.fasta} -dbtype nucl -parse_seqids -out {output.db_dir}/{wildcards.genome} -title {wildcards.genome} > {log} 2>&1
        """

rule extract_queries:
    input:
        gbk = os.path.join(GBK_DIR, "{gbk}.gbk")
    output:
        fasta = "results/queries/{gbk}_{target}.fasta"
    benchmark:
        "execution_reports/benchmarks/extract_queries/{gbk}_{target}.txt"
    log:
        "execution_reports/logs/extract_queries/{gbk}_{target}.log"
    conda:
        "envs/python.yaml"
    threads: 1
    resources:
        mem_mb=1000,
        runtime=10
    shell:
        "python workflow/scripts/extract_queries.py --gbk {input.gbk} --target {wildcards.target} --out {output.fasta} > {log} 2>&1"

rule local_blastn:
    input:
        fasta = "results/queries/{gbk}_{target}.fasta",
        db_dir = "resources/blast_dbs/{genome}"
    output:
        tsv = "results/blast/{genome}_{gbk}_{target}.tsv"
    benchmark:
        "execution_reports/benchmarks/local_blastn/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/blast/{genome}_{gbk}_{target}.log"
    conda:
        "envs/blast.yaml"
    threads: 4
    resources:
        mem_mb=4000,
        runtime=60
    params:
        db = "resources/blast_dbs/{genome}/{genome}",
        hspcov = config["blast_params"]["hspcoverage"],
        ident = config["blast_params"]["identity"],
        evalue = config["blast_params"]["evalue"]
    shell:
        """
        # Se o FASTA de query estiver vazio, criamos um output vazio para não quebrar o pipeline
        if [ ! -s {input.fasta} ]; then
            echo "Aviso: {input.fasta} vazio, ignorando BLAST." > {log} 2>&1
            touch {output.tsv}
        else
            echo "Rodando BLAST local para {wildcards.target} contra {wildcards.genome}..." > {log} 2>&1
            blastn -db {params.db} \\
                   -query {input.fasta} \\
                   -out {output.tsv} \\
                   -outfmt "6 qseqid sseqid sstart send sstrand pident qcovs" \\
                   -qcov_hsp_perc {params.hspcov} \\
                   -num_threads {threads} \\
                   -evalue {params.evalue} >> {log} 2>&1 || touch {output.tsv}
        fi
        """

rule summarize_hits:
    input:
        blasts = expand("results/blast/{genome}_{gbk}_{target}.tsv", genome=GENOMES, gbk=GBKS, target=TARGETS)
    output:
        summary = "results/summary_hits.tsv"
    benchmark:
        "execution_reports/benchmarks/summarize_hits.txt"
    log:
        "execution_reports/logs/summarize_hits.log"
    conda:
        "envs/python.yaml"
    threads: 1
    params:
        ltr_range = config["blast_params"]["LTR_range"]
    shell:
        "python workflow/scripts/parse_blast.py --blast_files {input.blasts} --out {output.summary} --ltr_range {params.ltr_range} > {log} 2>&1"

rule group_hits:
    input:
        blast = "results/blast/{genome}_{gbk}_{target}.tsv"
    output:
        loc_ltr = "results/coordinates/{genome}_{gbk}_{target}_loc_LTR.txt",
        loc_genic = "results/coordinates/{genome}_{gbk}_{target}_loc_genic.txt"
    benchmark:
        "execution_reports/benchmarks/group_hits/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/group_hits/{genome}_{gbk}_{target}.log"
    conda:
        "envs/python.yaml"
    threads: 1
    params:
        context_range = config["blast_params"]["context_range"],
        ltr_range = config["blast_params"]["LTR_range"]
    shell:
        """
        python workflow/scripts/group_hits.py --blast {input.blast} --out_ltr {output.loc_ltr} --out_genic {output.loc_genic} --context_range {params.context_range} --ltr_range {params.ltr_range} > {log} 2>&1
        """

rule extract_fastas:
    input:
        loc_ltr = "results/coordinates/{genome}_{gbk}_{target}_loc_LTR.txt",
        loc_genic = "results/coordinates/{genome}_{gbk}_{target}_loc_genic.txt",
        db_dir = "resources/blast_dbs/{genome}"
    output:
        fasta_ltr = "results/fasta/{genome}_{gbk}_{target}_regions_LTR.fasta",
        fasta_genic = "results/fasta/{genome}_{gbk}_{target}_regions_genic.fasta"
    benchmark:
        "execution_reports/benchmarks/extract_fastas/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/extract_fastas/{genome}_{gbk}_{target}.log"
    conda:
        "envs/blast.yaml"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=15
    params:
        db = "resources/blast_dbs/{genome}/{genome}"
    shell:
        """
        if [ -s {input.loc_ltr} ]; then
            blastdbcmd -db {params.db} -entry_batch {input.loc_ltr} -out {output.fasta_ltr} -line_length 99999 > {log} 2>&1
        else
            touch {output.fasta_ltr}
        fi
        
        if [ -s {input.loc_genic} ]; then
            blastdbcmd -db {params.db} -entry_batch {input.loc_genic} -out {output.fasta_genic} -line_length 99999 >> {log} 2>&1
        else
            touch {output.fasta_genic}
        fi
        """

rule delimit_sequences:
    input:
        fasta_genic = "results/fasta/{genome}_{gbk}_{target}_regions_genic.fasta"
    output:
        fasta_sig_genic = "results/fasta/{genome}_{gbk}_{target}_signature_genic.fasta"
    benchmark:
        "execution_reports/benchmarks/delimit_sequences/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/delimit_sequences/{genome}_{gbk}_{target}.log"
    conda:
        "envs/python.yaml"
    threads: 1
    params:
        ltr_range = config["blast_params"]["LTR_range"]
    shell:
        """
        if [ -s {input.fasta_genic} ]; then
            python workflow/scripts/delimit_sequences.py --input {input.fasta_genic} --output {output.fasta_sig_genic} --ltr_range {params.ltr_range} > {log} 2>&1
        else
            touch {output.fasta_sig_genic}
        fi
        """

rule align_mafft:
    input:
        fasta = "results/fasta/{genome}_{gbk}_{target}_signature_genic.fasta"
    output:
        aligned = temp("results/alignments/{genome}_{gbk}_{target}_aln.fasta")
    benchmark:
        "execution_reports/benchmarks/align_mafft/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/align_mafft/{genome}_{gbk}_{target}.log"
    conda:
        "envs/phylogeny.yaml"
    threads: 4
    shell:
        """
        if [ -s {input.fasta} ] && [ $(grep -c "^>" {input.fasta}) -ge 1 ]; then
            mafft --auto --thread {threads} {input.fasta} > {output.aligned} 2> {log}
        else
            touch {output.aligned}
        fi
        """

rule add_refs_mafft:
    input:
        aligned = "results/alignments/{genome}_{gbk}_{target}_aln.fasta",
        references = "resources/aln_retroviridae_references.fasta"
    output:
        final_aligned = "results/alignments/{genome}_{gbk}_{target}_final_aln.fasta"
    benchmark:
        "execution_reports/benchmarks/add_refs_mafft/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/add_refs_mafft/{genome}_{gbk}_{target}.log"
    conda:
        "envs/phylogeny.yaml"
    threads: 4
    shell:
        """
        if [ -s {input.aligned} ]; then
            mafft --thread {threads} --add {input.aligned} --keeplength {input.references} > {output.final_aligned} 2> {log}
        else
            touch {output.final_aligned}
        fi
        """

rule infer_phylogeny:
    input:
        alignment = "results/alignments/{genome}_{gbk}_{target}_final_aln.fasta"
    output:
        tree = "results/phylogeny/{genome}_{gbk}_{target}.treefile"
    benchmark:
        "execution_reports/benchmarks/infer_phylogeny/{genome}_{gbk}_{target}.txt"
    log:
        "execution_reports/logs/infer_phylogeny/{genome}_{gbk}_{target}.log"
    conda:
        "envs/phylogeny.yaml"
    threads: 4
    resources:
        mem_mb=8000,
        runtime=120
    params:
        prefix = "results/phylogeny/{genome}_{gbk}_{target}"
    shell:
        """
        if [ -s {input.alignment} ] && [ $(grep -c "^>" {input.alignment}) -ge 3 ]; then
            iqtree -s {input.alignment} -m GTR -B 10000 -alrt 1000 -T {threads} --undo --prefix {params.prefix} > {log} 2>&1
            # iqtree generates multiple files, snakemake will check for the .treefile
        else
            echo "Not enough sequences to build a tree." > {log}
            touch {output.tree}
        fi
        """
